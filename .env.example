# Supabase (Vite client) — safe to ship in the browser build
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Setup-only secrets — NEVER ship these in client code
# Used by `node scripts/supabase-setup.mjs`. Copy `.env.example` to `.env`.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase personal access token (App > Account > Access Tokens).
# Needed only to run DDL programmatically on projects where the legacy
# `/pg/query` endpoint is unavailable. Without it, paste supabase/migration.sql
# into Dashboard > SQL Editor first, then run the script to seed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ADMIN_EMAIL=admin@highgate.sch.uk
SUPABASE_ADMIN_PASSWORD=
